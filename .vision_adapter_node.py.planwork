import os
import subprocess
import threading

import rclpy
from rclpy.node import Node
from std_msgs.msg import String
from std_srvs.srv import SetBool


VISION_PYTHON = "/home/orangepi/Desktop/competition/.venv/bin/python"
VISION_SCRIPT = "/home/orangepi/Desktop/competition/gesture.py"
GESTURE_PREFIX = "GESTURE:"


class VisionAdapterNode(Node):
    """启动队友的视觉程序，并把它的文本结果转换为 ROS2 话题。"""

    def __init__(self):
        super().__init__("vision_adapter_node")

        self.gesture_publisher = self.create_publisher(
            String,
            "/vision/gesture",
            10,
        )
        self.start_service = self.create_service(
            SetBool,
            "/vision/start",
            self.start_callback,
        )

        self.process = None
        self.process_lock = threading.Lock()

        self.get_logger().info("vision_adapter_node started")

    def start_callback(self, request, response):
        """根据 Service 请求启动或停止 gesture.py。"""
        if request.data:
            with self.process_lock:
                if self.process is not None and self.process.poll() is None:
                    response.success = True
                    response.message = "vision already running"
                    return response

                try:
                    self._start_process_locked()
                except Exception as error:
                    response.success = False
                    response.message = f"vision start failed: {error}"
                    self.get_logger().error(response.message)
                    return response

            response.success = True
            response.message = "vision started"
            self.get_logger().info("已启动视觉识别程序")
            return response

        self._stop_process()
        response.success = True
        response.message = "vision stopped"
        self.get_logger().info("已停止视觉识别程序")
        return response

    def _start_process_locked(self):
        """在持有 process_lock 时启动视觉子进程。"""
        if not os.path.isfile(VISION_PYTHON):
            raise FileNotFoundError(f"找不到虚拟环境 Python：{VISION_PYTHON}")
        if not os.path.isfile(VISION_SCRIPT):
            raise FileNotFoundError(f"找不到视觉脚本：{VISION_SCRIPT}")

        environment = os.environ.copy()
        environment["PYTHONUNBUFFERED"] = "1"
        environment["XDG_RUNTIME_DIR"] = "/run/user/1000"
        environment["PULSE_SERVER"] = "unix:/run/user/1000/pulse/native"

        process = subprocess.Popen(
            [VISION_PYTHON, VISION_SCRIPT],
            cwd=os.path.dirname(VISION_SCRIPT),
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            encoding="utf-8",
            errors="replace",
            bufsize=1,
            env=environment,
        )
        self.process = process

        threading.Thread(
            target=self._read_stdout,
            args=(process,),
            daemon=True,
        ).start()
        threading.Thread(
            target=self._read_stderr,
            args=(process,),
            daemon=True,
        ).start()

    def _read_stdout(self, process):
        """读取视觉脚本的标准输出，只处理 GESTURE: 协议行。"""
        try:
            for line in process.stdout:
                line = line.strip()
                if not line.startswith(GESTURE_PREFIX):
                    continue

                gesture = line[len(GESTURE_PREFIX):].strip()
                if not gesture:
                    self.get_logger().warning("收到空的手势结果，已忽略")
                    continue

                message = String()
                message.data = gesture
                self.gesture_publisher.publish(message)
                self.get_logger().info(f"发布视觉结果：{gesture}")
        finally:
            if process.stdout is not None:
                process.stdout.close()
            return_code = process.wait()
            with self.process_lock:
                if self.process is process:
                    self.process = None
            if return_code == 0:
                self.get_logger().info("视觉程序已正常退出")
            else:
                self.get_logger().error(
                    f"视觉程序异常退出，返回码：{return_code}"
                )

    def _read_stderr(self, process):
        """把视觉脚本的普通日志转发到 ROS2 日志，不发布为手势。"""
        try:
            for line in process.stderr:
                line = line.strip()
                if line:
                    self.get_logger().info(f"[gesture] {line}")
        finally:
            if process.stderr is not None:
                process.stderr.close()

    def _stop_process(self):
        """停止视觉子进程，确保摄像头能够释放。"""
        with self.process_lock:
            process = self.process
            self.process = None

        if process is None or process.poll() is not None:
            return

        process.terminate()
        try:
            process.wait(timeout=3.0)
        except subprocess.TimeoutExpired:
            self.get_logger().warning("视觉程序未及时退出，强制结束")
            process.kill()
            process.wait()

    def destroy_node(self):
        self._stop_process()
        return super().destroy_node()


def main(args=None):
    rclpy.init(args=args)
    node = VisionAdapterNode()

    try:
        rclpy.spin(node)
    except KeyboardInterrupt:
        pass
    finally:
        node.destroy_node()
        rclpy.shutdown()


if __name__ == "__main__":
    main()
